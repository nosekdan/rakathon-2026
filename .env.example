MODEL_DEPLOYMENT=gpt-6-1-sol-dz-eu
PATIENT_MODEL_DEPLOYMENT=
TRIAL_MODEL_DEPLOYMENT=
# API_BASE_URL=https://apim-rakathon-q7146n.azure-api.net/openai/v1/
# Local models via Ollama: set a stage to ollama:<model>, e.g. PATIENT_MODEL_DEPLOYMENT=ollama:qwen2.5:7b
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_CONTEXT=32768
# Rule engine instead of a language model (no API key, runs locally in milliseconds): set any stage to trialmatch.
# MODEL_DEPLOYMENT=trialmatch+llm also lets a LOCAL model judge criteria the rules cannot structure.
# PATIENT_MODEL_DEPLOYMENT=trialmatch
# TRIAL_MODEL_DEPLOYMENT=trialmatch
# MODEL_DEPLOYMENT=trialmatch
# TM_LLM_BASE_URL=http://127.0.0.1:11434/v1
# TM_LLM_MODEL=qwen2.5:7b
